# ──────────────────────────────────────────────
# Contact form (app/api/contact)
# ──────────────────────────────────────────────
# Get a key at https://resend.com/api-keys — free tier: 3,000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives inquiries
CONTACT_TO_EMAIL=hello@launchdoor.studio

# "From" address shown on outgoing mail.
# Use `onboarding@resend.dev` until you verify launchdoor.studio in Resend,
# then switch to e.g. "Launchdoor <contact@launchdoor.studio>".
CONTACT_FROM_EMAIL=Launchdoor <onboarding@resend.dev>
